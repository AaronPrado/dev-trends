{
  "uid": "dev-trends-streaming",
  "title": "Streaming Kafka -> Silver",
  "schemaVersion": 39,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Latencia de micro-batch",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "dev_trends_streaming_batch_duration_seconds",
          "legendFormat": "{{query}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Filas por micro-batch",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "dev_trends_streaming_input_rows",
          "legendFormat": "{{query}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Lag de consumo del topic (offsets)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "dev_trends_streaming_kafka_max_offsets_behind_latest",
          "legendFormat": "{{query}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Ritmo: entrada vs proceso (filas/s)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "dev_trends_streaming_input_rows_per_second",
          "legendFormat": "entrada {{query}}"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "dev_trends_streaming_processed_rows_per_second",
          "legendFormat": "proceso {{query}}"
        }
      ]
    }
  ]
}
